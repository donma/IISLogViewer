<Window x:Class="IISLogExplorer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IIS Log Explorer"
        Width="1280"
        Height="780"
        MinWidth="860"
        MinHeight="560">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
            <MenuItem Header="檔案(_F)">
                <MenuItem Header="選擇資料夾" Command="{Binding SelectFolderCommand}" />
                <MenuItem Header="選擇 Log 檔案" Command="{Binding SelectFileCommand}" />
                <Separator />
                <MenuItem Header="結束" Click="OnExit" />
            </MenuItem>
            <MenuItem Header="工具(_T)">
                <MenuItem Header="偵測 IIS" Command="{Binding DetectIisCommand}" />
                <MenuItem Header="開始索引" Command="{Binding StartIndexCommand}" />
                <Separator />
                <MenuItem Header="最佳化 / VACUUM" Command="{Binding OptimizeCommand}" />
                <MenuItem Header="清除索引" Command="{Binding ClearIndexCommand}" />
                <MenuItem Header="重建索引" Command="{Binding RebuildIndexCommand}" />
            </MenuItem>
            <MenuItem Header="說明(_H)">
                <MenuItem Header="關於" Click="OnAbout" />
            </MenuItem>
        </Menu>

        <ToolBarTray Grid.Row="1" Background="{StaticResource WindowBrush}">
            <ToolBar Background="{StaticResource WindowBrush}" Band="0">
                <Button Content="選擇資料夾" Command="{Binding SelectFolderCommand}" />
                <Button Content="選擇 Log 檔案" Command="{Binding SelectFileCommand}" />
                <Button Content="偵測 IIS" Command="{Binding DetectIisCommand}" />
                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />
                <TextBlock VerticalAlignment="Center" Text="來源：" FontWeight="Bold" />
                <TextBlock VerticalAlignment="Center" Text="{Binding SourceName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Source.Path}" MaxWidth="500" />
            </ToolBar>
        </ToolBarTray>

        <Border Grid.Row="2" Padding="8" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="6,2,6,4">
            <StackPanel>
                <WrapPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <Label Content="IIS 站台：" />
                        <ComboBox Width="310" ItemsSource="{Binding IisSites}" SelectedItem="{Binding SelectedSite}" DisplayMemberPath="Name" />
                        <Button Content="使用站台" Command="{Binding UseSelectedSiteCommand}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label Content="最近來源：" />
                        <ComboBox Width="250" ItemsSource="{Binding RecentSources}" SelectedItem="{Binding SelectedRecentSource}" DisplayMemberPath="DisplayName" />
                        <Button Content="使用" Command="{Binding UseRecentSourceCommand}" />
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="3" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}" Margin="6,0,6,4">
            <TabItem Header="搜尋">
                <Grid Margin="4,6,4,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,4">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="搜尋" Background="{StaticResource AccentBrush}" Foreground="{StaticResource AccentTextBrush}" FontWeight="Bold" Command="{Binding SearchCommand}" />
                            <Button Content="停止" Command="{Binding StopSearchCommand}" />
                            <Button Content="CSV" Command="{Binding ExportCsvCommand}" />
                            <Button Content="JSON" Command="{Binding ExportJsonCommand}" />
                        </StackPanel>
                        <Label Content="關鍵字：" />
                        <TextBox VerticalContentAlignment="Center" Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" ToolTip="IP、404、POST、URL 或一般文字" />
                    </DockPanel>
                    <Expander Grid.Row="1" Header="更多篩選" IsExpanded="False" Margin="0,2,0,4" Background="{StaticResource PanelBrush}">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <WrapPanel Margin="0,4,0,0" ItemHeight="52">
                                <StackPanel><Label Content="Method" /><ComboBox Width="100" ItemsSource="{Binding Methods}" SelectedItem="{Binding MethodFilter}" /></StackPanel>
                                <StackPanel><Label Content="Status" /><TextBox Width="64" Text="{Binding StatusFilter, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                <StackPanel><Label Content="Client IP" /><TextBox Width="120" Text="{Binding IpFilter, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                <StackPanel><Label Content="URL contains" /><TextBox Width="150" Text="{Binding UrlFilter, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                <StackPanel><Label Content="User Agent" /><TextBox Width="150" Text="{Binding UserAgentFilter, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                <StackPanel><Label Content="Username" /><TextBox Width="110" Text="{Binding UsernameFilter, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                <StackPanel><Label Content="Min ms" /><TextBox Width="60" Text="{Binding MinTime, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                <StackPanel><Label Content="Max ms" /><TextBox Width="60" Text="{Binding MaxTime, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                <StackPanel><Label Content="Page size" /><ComboBox Width="80" ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize}" /></StackPanel>
                                <StackPanel><Label Content="Quick range" /><ComboBox Width="110" ItemsSource="{Binding QuickRanges}" SelectedItem="{Binding QuickRange}" /></StackPanel>
                                <StackPanel><Label Content="Date from" /><DatePicker Width="110" SelectedDate="{Binding DateFrom}" /></StackPanel>
                                <StackPanel><Label Content="Date to" /><DatePicker Width="110" SelectedDate="{Binding DateTo}" /></StackPanel>
                                <StackPanel><Label Content="Time from (UTC)" /><TextBox Width="78" Text="{Binding TimeFrom, UpdateSourceTrigger=PropertyChanged}" ToolTip="HH:mm:ss" /></StackPanel>
                                <StackPanel><Label Content="Time to (UTC)" /><TextBox Width="78" Text="{Binding TimeTo, UpdateSourceTrigger=PropertyChanged}" ToolTip="HH:mm:ss" /></StackPanel>
                            </WrapPanel>
                        </ScrollViewer>
                    </Expander>
                    <Grid Grid.Row="2">
                        <DataGrid ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}" MouseDoubleClick="ResultDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Width="155" Binding="{Binding Entry.TimestampLocal, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
                                <DataGridTextColumn Header="Status" Width="60" Binding="{Binding Entry.DisplayStatus}" />
                                <DataGridTextColumn Header="Method" Width="70" Binding="{Binding Entry.Method}" />
                                <DataGridTextColumn Header="Client IP" Width="130" Binding="{Binding Entry.ResolvedClientIp}" />
                                <DataGridTextColumn Header="URL" Width="*" Binding="{Binding Entry.DisplayUrl}" />
                                <DataGridTextColumn Header="ms" Width="70" Binding="{Binding Entry.TimeTakenMs}" />
                                <DataGridTextColumn Header="User Agent" Width="240" Binding="{Binding Entry.UserAgent}" />
                                <DataGridTextColumn Header="File" Width="140" Binding="{Binding SourceFile}" />
                                <DataGridTextColumn Header="Line" Width="60" Binding="{Binding Entry.LineNumber}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="尚未搜尋。請先選擇來源並輸入關鍵字。">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Results.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="IP 分析">
                <ScrollViewer Margin="8">
                    <StackPanel>
                        <TextBlock FontWeight="Bold" Text="IP 分析" />
                        <TextBlock Margin="0,2,0,8" Foreground="{StaticResource MutedBrush}" Text="先在搜尋選擇一筆 Request，再按分析 IP。" />
                        <Button HorizontalAlignment="Left" Content="分析選取的 IP" Command="{Binding AnalyzeIpCommand}" />
                        <UniformGrid Columns="4" Margin="0,10,0,10">
                            <Border Padding="8" Margin="3" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"><StackPanel><TextBlock Foreground="{StaticResource MutedBrush}" Text="IP" /><TextBlock Text="{Binding IpResult.Ip}" /></StackPanel></Border>
                            <Border Padding="8" Margin="3" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"><StackPanel><TextBlock Foreground="{StaticResource MutedBrush}" Text="Requests" /><TextBlock Text="{Binding IpResult.RequestCount}" /></StackPanel></Border>
                            <Border Padding="8" Margin="3" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"><StackPanel><TextBlock Foreground="{StaticResource MutedBrush}" Text="Unique URLs" /><TextBlock Text="{Binding IpResult.UniqueUrls}" /></StackPanel></Border>
                            <Border Padding="8" Margin="3" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"><StackPanel><TextBlock Foreground="{StaticResource MutedBrush}" Text="404 / 500" /><TextBlock><Run Text="{Binding IpResult.NotFoundCount}" /><Run Text=" / " /><Run Text="{Binding IpResult.ServerErrorCount}" /></TextBlock></StackPanel></Border>
                        </UniformGrid>
                        <TextBlock FontWeight="Bold" Text="IP Timeline" />
                        <DataGrid MaxHeight="400" ItemsSource="{Binding IpResult.Timeline}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Width="170" Binding="{Binding Timestamp}" />
                                <DataGridTextColumn Header="Method" Width="80" Binding="{Binding Method}" />
                                <DataGridTextColumn Header="URL" Width="*" Binding="{Binding Url}" />
                                <DataGridTextColumn Header="Status" Width="80" Binding="{Binding Status}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="錯誤">
                <StackPanel Margin="8">
                    <TextBlock FontWeight="Bold" Text="錯誤分析" />
                    <TextBlock Margin="0,2,0,8" Foreground="{StaticResource MutedBrush}" Text="僅在按下開始分析後執行 4xx / 5xx 統計。" />
                    <Button HorizontalAlignment="Left" Content="開始錯誤分析" Command="{Binding AnalyzeErrorsCommand}" />
                    <TextBlock Margin="0,10,0,4" Text="總錯誤數: " /><TextBlock Text="{Binding ErrorResult.TotalErrors}" />
                    <TextBlock FontWeight="Bold" Text="狀態碼分佈" />
                    <ItemsControl ItemsSource="{Binding ErrorResult.StatusDistribution}" Margin="0,4,0,12">
                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock><Run Text="Status " /><Run Text="{Binding Key}" /><Run Text=": " /><Run Text="{Binding Value}" /></TextBlock></DataTemplate>
                    </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock FontWeight="Bold" Text="Top Error URLs" />
                    <ItemsControl ItemsSource="{Binding ErrorResult.TopErrorUrls}" Margin="0,4">
                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding Item1}" /><Run Text=" — " /><Run Text="{Binding Item2}" /></TextBlock></DataTemplate>
                    </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </TabItem>
            <TabItem Header="資安">
                <ScrollViewer Margin="8">
                    <StackPanel>
                        <TextBlock FontWeight="Bold" Text="資安分析器" />
                        <TextBlock Margin="0,2,0,8" Foreground="{StaticResource MutedBrush}" Text="僅為啟發式指標；不代表攻擊成功。" />
                        <StackPanel Orientation="Horizontal"><Button Content="分析目前篩選" Command="{Binding StartSecurityAnalysisCommand}" /><Button Content="分析整個來源" Command="{Binding AnalyzeEntireSourceCommand}" /><Button Content="停止" Command="{Binding StopAnalysisCommand}" /></StackPanel>
                        <UniformGrid Columns="3" Margin="0,10,0,10">
                            <Border Padding="8" Margin="3" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"><StackPanel><TextBlock Foreground="{StaticResource MutedBrush}" Text="Score" /><TextBlock FontSize="22" FontWeight="Bold" Text="{Binding SecurityResult.Score}" /></StackPanel></Border>
                            <Border Padding="8" Margin="3" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"><StackPanel><TextBlock Foreground="{StaticResource MutedBrush}" Text="Risk" /><TextBlock FontSize="18" Text="{Binding SecurityResult.Severity}" /></StackPanel></Border>
                            <Border Padding="8" Margin="3" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"><StackPanel><TextBlock Foreground="{StaticResource MutedBrush}" Text="Scanner" /><TextBlock FontSize="18" Text="{Binding SecurityResult.LikelyScanner}" /></StackPanel></Border>
                        </UniformGrid>
                        <TextBlock FontWeight="Bold" Text="原因" />
                        <ItemsControl ItemsSource="{Binding SecurityResult.Reasons}" Margin="0,4,0,12" />
                        <TextBlock FontWeight="Bold" Text="Findings" />
                        <DataGrid MaxHeight="400" ItemsSource="{Binding SecurityResult.Findings}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Title" Width="200" Binding="{Binding Title}" />
                                <DataGridTextColumn Header="IP" Width="140" Binding="{Binding ClientIp}" />
                                <DataGridTextColumn Header="URL" Width="*" Binding="{Binding Uri}" />
                                <DataGridTextColumn Header="Reason" Width="350" Binding="{Binding Reason}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="慢請求">
                <StackPanel Margin="8">
                    <TextBlock FontWeight="Bold" Text="慢請求分析" />
                    <StackPanel Orientation="Horizontal" Margin="0,8"><Label Content="Threshold (ms)" /><TextBox Width="90" Text="{Binding SlowThreshold, UpdateSourceTrigger=PropertyChanged}" /><Button Content="開始分析" Command="{Binding AnalyzeSlowCommand}" /></StackPanel>
                    <UniformGrid Columns="5" Margin="0,6,0,12">
                        <TextBlock><Run Text="Requests: " /><Run Text="{Binding SlowResult.RequestCount}" /></TextBlock>
                        <TextBlock><Run Text="Avg: " /><Run Text="{Binding SlowResult.AverageDurationMs, StringFormat={}{0:0}}" /><Run Text=" ms" /></TextBlock>
                        <TextBlock><Run Text="P95: " /><Run Text="{Binding SlowResult.P95, StringFormat={}{0:0}}" /><Run Text=" ms" /></TextBlock>
                        <TextBlock><Run Text="P99: " /><Run Text="{Binding SlowResult.P99, StringFormat={}{0:0}}" /><Run Text=" ms" /></TextBlock>
                        <TextBlock><Run Text="Max: " /><Run Text="{Binding SlowResult.MaxDurationMs, StringFormat={}{0}}" /><Run Text=" ms" /></TextBlock>
                    </UniformGrid>
                    <TextBlock FontWeight="Bold" Text="Top Slow URLs" />
                    <ItemsControl ItemsSource="{Binding SlowResult.TopSlowUrls}" Margin="0,4">
                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding Item1}" /><Run Text=" — avg " /><Run Text="{Binding Item2, StringFormat={}{0:0}}" /><Run Text=" ms — " /><Run Text="{Binding Item3}" /><Run Text=" requests" /></TextBlock></DataTemplate>
                    </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </TabItem>
            <TabItem Header="流量">
                <ScrollViewer Margin="8">
                    <StackPanel>
                        <TextBlock FontWeight="Bold" Text="流量分析" />
                        <TextBlock Margin="0,2,0,8" Foreground="{StaticResource MutedBrush}" Text="不會在切頁時自動執行。" />
                        <Button HorizontalAlignment="Left" Content="開始流量分析" Command="{Binding AnalyzeTrafficCommand}" />
                        <UniformGrid Columns="3" Margin="0,10">
                            <TextBlock><Run Text="Total: " /><Run Text="{Binding TrafficResult.TotalRequests}" /></TextBlock>
                            <TextBlock><Run Text="Unique IPs: " /><Run Text="{Binding TrafficResult.UniqueIps}" /></TextBlock>
                            <TextBlock><Run Text="Req/min: " /><Run Text="{Binding TrafficResult.RequestsPerMinute, StringFormat={}{0:0.00}}" /></TextBlock>
                        </UniformGrid>
                        <TextBlock FontWeight="Bold" Text="趨勢" />
                        <ItemsControl ItemsSource="{Binding TrafficResult.Trend}" Margin="0,4">
                            <ItemsControl.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding Item1}" /><Run Text=" — " /><Run Text="{Binding Item2}" /></TextBlock></DataTemplate>
                        </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="設定">
                <StackPanel Margin="8" Width="480" HorizontalAlignment="Left">
                    <TextBlock FontWeight="Bold" Text="設定" />
                    <TextBlock Margin="0,2,0,12" Foreground="{StaticResource MutedBrush}" Text="設定檔位於 exe 同層 settings.json。" />
                    <StackPanel Orientation="Horizontal"><Label Width="180" Content="Default Page Size" /><ComboBox Width="100" ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize}" /></StackPanel>
                    <StackPanel Orientation="Horizontal"><Label Width="180" Content="Index Batch Size" /><TextBox Width="100" Text="{Binding IndexBatchSize, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    <StackPanel Orientation="Horizontal"><Label Width="180" Content="Max Search Results" /><TextBox Width="100" Text="{Binding MaxSearchResults, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    <StackPanel Orientation="Horizontal"><Label Width="180" Content="Slow Request Threshold" /><TextBox Width="100" Text="{Binding SlowThreshold}" /></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4"><CheckBox Width="180" IsChecked="{Binding IncludeSubfolders}" Content="包含子資料夾" /><TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="掃描子資料夾" /></StackPanel>
                    <StackPanel Orientation="Horizontal"><Label Width="180" Content="Database Retention" /><ComboBox Width="120" ItemsSource="{Binding RetentionOptions}" SelectedItem="{Binding Retention}" /></StackPanel>
                    <StackPanel Orientation="Horizontal"><Label Width="180" Content="Realtime Refresh (sec)" /><TextBox Width="100" Text="{Binding RealtimeIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    <StackPanel Orientation="Horizontal"><Label Width="180" Content="Theme" /><TextBlock VerticalAlignment="Center" Text="Classic (Win32)" /></StackPanel>
                    <Button HorizontalAlignment="Left" Margin="0,8" Content="儲存設定" Command="{Binding SaveSettingsCommand}" />
                    <Separator Margin="0,12" />
                    <TextBlock FontWeight="Bold" Text="資料庫維護" />
                    <StackPanel Orientation="Horizontal" Margin="0,4"><Button Content="Optimize / VACUUM" Command="{Binding OptimizeCommand}" /><Button Content="Clear Index" Command="{Binding ClearIndexCommand}" /><Button Content="Rebuild Index" Command="{Binding RebuildIndexCommand}" /><Button Content="立即清理" Command="{Binding CleanupNowCommand}" /></StackPanel>
                    <TextBlock Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}" Text="原始 IIS Log 永遠唯讀；清除只影響 SQLite。" />
                </StackPanel>
            </TabItem>
        </TabControl>

        <Border Grid.Row="4" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="4,2" Margin="6,0,6,4">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="停止索引" Command="{Binding StopIndexCommand}" />
                    <Button Content="Realtime ON" Command="{Binding StartRealtimeCommand}" />
                    <Button Content="Realtime OFF" Command="{Binding StopRealtimeCommand}" />
                </StackPanel>
                <TextBlock VerticalAlignment="Center" Text="{Binding StatusMessage}" />
                <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{StaticResource MutedBrush}" Text="{Binding IndexMessage}" />
                <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{StaticResource MutedBrush}" Text="{Binding DbStatus}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>